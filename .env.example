# ======================================================================
# QomraNote configuration
# Copy to .env — docker-compose and the API (godotenv) both read it.
# ======================================================================

# ---- app ----
APP_ENV=development            # development | production
LOG_LEVEL=info                 # debug | info | warn | error

# ---- MongoDB (local, per current setup) ----
MONGO_URI=mongodb://localhost:27017
MONGO_DB=qomranote

# ---- Keycloak ----
# Issuer = the URL embedded in tokens (what the BROWSER uses).
# Internal base = how the API reaches Keycloak (docker service name in compose).
KEYCLOAK_ISSUER=http://localhost:8081/realms/qomranote
KEYCLOAK_INTERNAL_BASE=http://localhost:8081
KEYCLOAK_REALM=qomranote
KEYCLOAK_ADMIN_CLIENT_ID=qomranote-api
KEYCLOAK_ADMIN_CLIENT_SECRET=qomranote-api-secret-change-me
KEYCLOAK_WEB_CLIENT_ID=qomranote-web

# ---- object storage ----
# Driver "local" stores uploads on disk through the API (works out of the
# box). Flip to "r2" once the Cloudflare R2 credentials below are filled in —
# the presigned direct-to-storage flow activates automatically.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./data/uploads
PUBLIC_API_BASE=http://localhost:8080

# ---- Cloudflare R2 (S3-compatible) — FILL THESE IN WHEN READY ----
# R2 dashboard → R2 → Manage API Tokens → create an S3 auth token.
R2_ACCOUNT_ID=__FILL_ME__
R2_ACCESS_KEY_ID=__FILL_ME__
R2_SECRET_ACCESS_KEY=__FILL_ME__
R2_BUCKET=qomranote
# Optional: public bucket / custom domain base URL for direct object reads.
# Leave empty to serve objects via 7-day presigned GET URLs instead.
R2_PUBLIC_BASE_URL=

# ---- HTTP ----
HTTP_ADDR=:8080
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- AI agent (opt-in) ----
# Leave the key for your chosen provider empty and the agent is disabled:
# /api/v1/agent/* reports the feature unavailable, every entry point stays
# hidden, and nothing else about the stack changes.
AGENT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Model for agent runs. Blank picks a sensible default for the provider;
# on Gemini it is discovered from the API.
AGENT_MODEL=claude-opus-5
# Per-user, per-UTC-day spend ceiling in USD. 0 = uncapped.
AGENT_DAILY_CAP_USD=2.00
# Rates in USD per million tokens. LEAVE BLANK unless your model is missing
# from the built-in table in cognition/provider.go, or you are billed a
# negotiated rate. Setting these OVERRIDES the verified rates. The server
# warns at boot if the resolved model has no known price, because an unpriced
# model reports $0 and the daily cap can never bind.
AGENT_PRICE_INPUT_PER_1M=
AGENT_PRICE_OUTPUT_PER_1M=
